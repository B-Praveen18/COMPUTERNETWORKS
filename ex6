#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 8056
#define BUFSIZE 1024

/* socket + connect -- returns the connected socket */
int connectTCP(const char *ip) {
    int sock;
    struct sockaddr_in server_addr;

    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) { perror("[ERROR] socket"); exit(1); }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    if (inet_pton(AF_INET, ip, &server_addr.sin_addr) <= 0) {
        fprintf(stderr, "[ERROR] Invalid address\n"); exit(1);
    }

    if (connect(sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("[ERROR] connect"); exit(1);
    }
    printf("========================================\n");
    printf("[STATUS]  Connected to server (%s:%d)\n", ip, PORT);
    printf("========================================\n");
    return sock;
}

void displayMenu() {
    printf("\n+--------------------------------------+\n");
    printf("|         T C P   C L I E N T          |\n");
    printf("+--------------------------------------+\n");
    printf("|  [1] Echo                            |\n");
    printf("|  [2] Factorial                       |\n");
    printf("|  [3] Exit                            |\n");
    printf("+--------------------------------------+\n");
    printf("Enter your choice: ");
}

void handleEcho(int sock) {
    char msg[BUFSIZE / 2], request[BUFSIZE], response[BUFSIZE];
    int n;

    printf("\n  >> Enter message: ");
    fgets(msg, sizeof(msg), stdin);
    msg[strcspn(msg, "\n")] = '\0';

    snprintf(request, BUFSIZE, "1|%s", msg);
    send(sock, request, strlen(request), 0);

    n = recv(sock, response, BUFSIZE - 1, 0);
    if (n <= 0) { printf("[ERROR] Server closed connection.\n"); exit(1); }
    response[n] = '\0';
    printf("  << Echo from server: \"%s\"\n", response);
}

void handleFactorial(int sock) {
    char request[BUFSIZE], response[BUFSIZE];
    int num, n;

    printf("\n  >> Enter a number: ");
    if (scanf("%d", &num) != 1) { while (getchar() != '\n'); printf("[ERROR] Invalid input.\n"); return; }
    getchar();

    snprintf(request, BUFSIZE, "2|%d", num);
    send(sock, request, strlen(request), 0);

    n = recv(sock, response, BUFSIZE - 1, 0);
    if (n <= 0) { printf("[ERROR] Server closed connection.\n"); exit(1); }
    response[n] = '\0';
    printf("  << Server response: %s\n", response);
}

int main(int argc, char *argv[]) {
    const char *ip = (argc > 1) ? argv[1] : "127.0.0.1";
    int sock, choice;

    sock = connectTCP(ip);

    while (1) {
        displayMenu();
        if (scanf("%d", &choice) != 1) { while (getchar() != '\n'); printf("[ERROR] Invalid input.\n"); continue; }
        getchar();

        switch (choice) {
            case 1:
                handleEcho(sock);
                break;
            case 2:
                handleFactorial(sock);
                break;
            case 3:
                send(sock, "3|", 2, 0);
                printf("\n========================================\n");
                printf("[STATUS]  Exiting... Goodbye!\n");
                printf("========================================\n");
                close(sock);
                return 0;
            default:
                printf("\n[WARNING] Invalid choice. Try again.\n");
        }
    }
}

