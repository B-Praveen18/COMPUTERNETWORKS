'use strict';

function bitwiseAnd(N, K) {
    let max = 0;

    for (let a = 1; a <= N; a++) {
        for (let b = a + 1; b <= N; b++) {
            let value = a & b;

            if (value < K && value > max) {
                max = value;
            }
        }
    }

    return max;
}

